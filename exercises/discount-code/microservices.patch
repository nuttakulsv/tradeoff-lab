@@ -0,0 +1,46 @@
+import { randomUUID } from 'node:crypto';
+import { setTimeout as sleep } from 'node:timers/promises';
+import { describe, expect, it } from 'vitest';
+
+const BASE = process.env.API_URL ?? 'http://127.0.0.1:4000';
+const PROVIDER = process.env.PAYMENT_PROVIDER_URL ?? 'http://127.0.0.1:4010';
+
+async function place(body: unknown) {
+  const res = await fetch(`${BASE}/orders`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(body),
+  });
+  return { status: res.status, body: await res.json() };
+}
+
+async function settle(id: string) {
+  for (let i = 0; i < 300; i++) {
+    const order = await (await fetch(`${BASE}/orders/${id}`)).json();
+    if (order.status !== 'PENDING') return order;
+    await sleep(25);
+  }
+}
+
+describe('discount codes', () => {
+  it('charges the discounted amount', async () => {
+    const placed = await place({
+      customerId: `c-${randomUUID()}`,
+      items: [{ sku: 'LATTE', qty: 2 }],
+      discountCode: 'welcome10',
+    });
+    const order = await settle(placed.body.id);
+    expect(order).toMatchObject({ status: 'CONFIRMED', discountCode: 'WELCOME10', amount: 15300 });
+    const ledger = await (await fetch(`${PROVIDER}/ledger`)).json();
+    expect(ledger.charges.find((c: { key: string }) => c.key === order.id).amount).toBe(15300);
+  });
+
+  it('refuses an unknown code before taking any stock', async () => {
+    const placed = await place({
+      customerId: `c-${randomUUID()}`,
+      items: [{ sku: 'LATTE', qty: 1 }],
+      discountCode: 'FREEBIES',
+    });
+    expect(placed.status).toBe(400);
+  });
+});
